# App Environment
APP_ENV=development
APP_PORT=8080

# Security
JWT_SECRET=super-secret-key-change-in-prod
JWT_REFRESH_SECRET=refresh-secret-key-change-in-prod

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=skillbridge
DB_SSLMODE=disable

# Cache (Redis) Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Messaging (NATS) Configuration
NATS_URL=nats://localhost:4222

# External Code Execution (Judge0)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=your-rapidapi-key

# External AI Service
EXTERNAL_AI_URL=https://api.external-ai.com
EXTERNAL_AI_KEY=your-external-ai-key
